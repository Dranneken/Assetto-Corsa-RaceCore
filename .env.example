RACECORE_ENV=development
RACECORE_HOST=127.0.0.1
RACECORE_PORT=8000
RACECORE_LOG_LEVEL=INFO
RACECORE_ADMIN_USERNAME=race-admin
# Replace this placeholder with a unique random password before starting RaceCore.
RACECORE_ADMIN_PASSWORD=replace-with-a-long-random-password

# Uncomment and set this after PostgreSQL is running and the racecore database exists.
# RACECORE_DATABASE_URL=postgresql+psycopg://racecore:change-me@127.0.0.1:5432/racecore
